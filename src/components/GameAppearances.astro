];
---

<section class="section-padding">
  <div class="container">
    <div class="row justify-content-center align-items-start">

      <div class="col-12 text-center">
        <h2 class="mb-5">Appearances in other games</h2>
      </div>

      <div class="row mt-5 justify-content-center align-items-start">

        {appearances.map((appearance) => (
          <div class="col-md-6 text-center mb-5">
            <a href={appearance.url} target="_blank">
              <h4 class="mb-5">{appearance.name}</h4>
            </a>
            <div id="other-gallery">
              {appearance.gallery.map((item, idx) => (
                <div class="col-lg-5 other-gallery-item m-2">
                  <img loading="lazy" src={item.image} class="artists-image img-fluid game-appearance-img" style="cursor: pointer;" />
                  {item.links && item.links.length > 0 && (
                    <div class="social-icon-container">
                      <ul class="social-icon">
                        {item.links.map((link) => (
                          <li class="social-icon-item">
                            <a href={link.url} class="social-icon-link" target="_blank">
                              <span class={link.icon}></span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}

      </div>
    </div>
  </div>
</section>
