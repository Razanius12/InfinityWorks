---
interface GameAppearance {
  name: string;
  url: string;
  gallery: Array<{
    image: string;
    links?: Array<{
      platform: string;
      icon: string;
      url: string;
    }>;
  }>;
}

const appearances: GameAppearance[] = [
  {
    name: 'Highway Warriors 2',
    url: 'https://jreo.itch.io/hw2',
    gallery: [
      {
        image: '/images/gallery/other/HighwayWarriors2_jreo-1.png',
        links: [
          {
            platform: 'youtube',
            icon: 'bi-youtube',
            url: 'https://youtu.be/zR7HBrJ6XkU'
          }
        ]
      },
      {
        image: '/images/gallery/other/HighwayWarriors2_jreo-2.png',
        links: [
          {
            platform: 'youtube',
            icon: 'bi-youtube',
            url: 'https://youtu.be/P0mC8fgt01I'
          }
        ]
      },
      {
        image: '/images/gallery/other/HighwayWarriors2_jreo-3.png',
        links: [
          {
            platform: 'twitter',
            icon: 'bi-twitter',
            url: 'https://x.com/jreo03_tscn/status/1821198386592412131'
          },
          {
            platform: 'youtube',
            icon: 'bi-youtube',
            url: 'https://youtu.be/pRJkTEnIgao'
          }
        ]
      }
    ]
  },
  {
    name: 'Street Racing (The Rise)',
    url: 'https://play.google.com/store/apps/details?id=com.therise.streetracing&pcampaignid=web_share',
    gallery: [
      {
        image: '/images/gallery/other/StreetRacing_TheRise-1.jpg'
      }
    ]
  },
  {
    name: 'Night-Runners Prologue',
    url: 'https://store.steampowered.com/app/2707900/NIGHTRUNNERS_PROLOGUE/',
    gallery: [
      {
        image: '/images/gallery/other/NightRunners_PLANETJEM-1.png'
      },
      {
        image: '/images/gallery/other/NightRunners_PLANETJEM-2.png'
      }
    ]
  },
  {
    name: 'Static Shift Racing',
    url: 'https://play.google.com/store/apps/details?id=com.timbojimbo.ssr&pcampaignid=web_share',
    gallery: [
      {
        image: '/images/gallery/other/SSR_TimboJimbo-1.png'
      },
      {
