---
import CTA from './CTA.astro';
---

<CTA
  title="Find Out More Here!"
  buttonText="Join Our Discord"
  buttonHref="https://discord.com/invite/93xgQjW"
/>

<footer class="site-footer">
  <div class="container">
    <div class="row">
      <div class="col-auto">
        <h2 class="text-white mb-lg-0">Infinity</h2>
      </div>

      <div class="col"></div>

      <div class="col-auto d-flex justify-content-lg-end align-items-center">
        <ul class="social-icon d-flex justify-content-lg-end">
          <li class="social-icon-item">
            <a
              href="https://www.instagram.com/works_infinity"
              class="social-icon-link"
              target="_blank"
              aria-label="Follow Infinity Works on Instagram"
            >
              <span class="bi-instagram"></span>
            </a>
          </li>

          <li class="social-icon-item">
            <a
              href="https://discord.com/invite/93xgQjW"
              class="social-icon-link"
              target="_blank"
              aria-label="Join Infinity Works on Discord"
            >
              <span class="bi-discord"></span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col-auto mt-4">
        <p class="copyright-text">
          Copyright &copy;
          <span id="year"></span>
          Infinity Works
        </p>
      </div>

      <div class="col mt-4"></div>

      <div class="col-auto mt-4">
        <p class="distribution-text">
          Distributed by: <a href="https://themewagon.com" target="_blank">ThemeWagon</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>
