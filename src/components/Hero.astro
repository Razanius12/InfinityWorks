---
---

<section class="hero-section" id="section_1">
  <div class="section-overlay"></div>

  <div class="container justify-content-center align-items-center">
    <div class="row">

      <div class="col-12 mt-auto mb-3 text-center">
        <small>Born From The Ashes</small>

        <h1 class="text-white mb-5">This is Infinity</h1>

        <a class="btn custom-btn smoothscroll" href="#section_2">Let's begin</a>
      </div>

      <div class="col mt-auto d-flex flex-row-reverse">

        <div class="social-share">
          <ul class="social-icon d-flex align-items-center justify-content-flex-start">

            <li class="social-icon-item">
              <a href="https://www.instagram.com/works_infinity" class="social-icon-link" target="_blank" rel="noopener noreferrer">
                <span class="bi-instagram"></span>
              </a>
            </li>

            <li class="social-icon-item">
              <a href="https://discord.com/invite/93xgQjW" class="social-icon-link" target="_blank" rel="noopener noreferrer">
                <span class="bi-discord"></span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="video-wrap">
    <video 
      autoplay
      loop
      muted
      playsinline
      class="custom-video" 
      poster="/images/gallery/9.jpg"
    >
      <source src="/video/infinity.mp4" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>
</section>
