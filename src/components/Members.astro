<section class="artists section-padding" id="section_3">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 text-center">
        <h2 class="mb-5">Members</h2>
      </div>
    </div>

    <!-- Desktop Grid -->
    <div
      id="membersGrid"
      class="row row-cols-1 row-cols-md-3 g-4 justify-content-center d-none d-md-flex"
    >
      {
        members.map((member) => (
          <div class="col">
            <div class="card h-100 artists-image">
              <img
                loading="lazy"
                src={member.image}
                alt={`${member.name} - ${member.title}`}
                class="card-img-top artists-card-image"
              />
              <div class="card-body">
                <h4 class="card-title">{member.name}</h4>
                <p class="card-text">
                  <i>{member.title}</i>
                </p>
                <p class="card-text">"{member.quote}"</p>
              </div>

              <div class="card-footer">
                <div class="col mt-auto d-flex flex-row-reverse">
                  <ul class="social-icon">
                    {member.social.map((link) => (
                      <li class="social-icon-item">
                        <a
                          href={link.url}
                          class="social-icon-link mt-2 mb-2"
                          target="_blank"
                          aria-label={`${member.name}'s ${link.platform}`}
                        >
                          <span class={link.icon} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Carousel -->
    <div id="membersCarousel" class="carousel slide d-md-none" data-bs-ride="carousel">
      <div class="carousel-inner">
        {
          members.map((member, index) => (
            <div class={`carousel-item ${index === 0 ? 'active' : ''}`}>
              <div class="card h-100 artists-image">
                <img
                  loading="lazy"
                  src={member.image}
                  alt={`${member.name} - ${member.title}`}
                  class="card-img-top artists-card-image"
                />
                <div class="card-body">
                  <h4 class="card-title">{member.name}</h4>
                  <p class="card-text">
                    <i>{member.title}</i>
                  </p>
                  <p class="card-text">"{member.quote}"</p>
                </div>

                <div class="card-footer">
                  <div class="col mt-auto d-flex flex-row-reverse">
                    <ul class="social-icon">
                      {member.social.map((link) => (
                        <li class="social-icon-item">
                          <a
                            href={link.url}
                            class="social-icon-link mt-2 mb-2"
                            target="_blank"
                            aria-label={`${member.name}'s ${link.platform}`}
                          >
                            <span class={link.icon} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#membersCarousel"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#membersCarousel"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  // Carousel controls positioning
  function adjustCarouselControls() {
    const activeItem = document.querySelector('.carousel-item.active');
    if (activeItem) {
      const cardImage = activeItem.querySelector('.card-img-top.artists-card-image');
      const prevControl = document.querySelector('.carousel-control-prev');
      const nextControl = document.querySelector('.carousel-control-next');

      if (window.matchMedia('(max-width: 576px)').matches) {
        if (cardImage) {
          const imageHeight = cardImage.offsetHeight;
          const topPosition = imageHeight - 24;
          if (prevControl) prevControl.style.top = `${topPosition}px`;
          if (nextControl) nextControl.style.top = `${topPosition}px`;
        }
      } else if (window.matchMedia('(max-width: 620px)').matches) {
        const baseTop = 265;
        const topPosition = baseTop - 24;
        const finalPosition = Math.max(topPosition, 24);

        if (prevControl) prevControl.style.top = `${finalPosition}px`;
        if (nextControl) nextControl.style.top = `${finalPosition}px`;
      } else {
        if (prevControl) prevControl.style.top = '';
        if (nextControl) nextControl.style.top = '';
      }
    }
  }

  if (typeof bootstrap !== 'undefined') {
    const carouselElement = document.getElementById('membersCarousel');
    if (carouselElement) {
      const myCarousel = new bootstrap.Carousel(carouselElement, {
        interval: 5000,
        wrap: true,
        touch: true,
      });

      adjustCarouselControls();
      carouselElement.addEventListener('slid.bs.carousel', adjustCarouselControls);

      let resizeTimeout;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(adjustCarouselControls, 250);
      });
    }
  }
</script>
