---
/**
 * Call To Action Component
 * Used for promotional sections with background image
 */

interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  backgroundImage?: string;
}

const {
  title = 'Find Out More Here!',
  subtitle = undefined,
  buttonText = 'Join Our Discord',
  buttonHref = 'https://discord.com/invite/93xgQjW',
  backgroundImage = '/images/infinityCarsBlur38kb.jpg',
} = Astro.props;
---

<section class="cta-section" style={`background-image: url('${backgroundImage}')`}>
  <div class="cta-overlay"></div>
  <div class="container">
    <div class="row">
      <div class="col-12 text-center">
        {title && <h3 class="cta-title">{title}</h3>}
        {subtitle && <p class="cta-subtitle">{subtitle}</p>}

        {
          buttonHref && (
            <a
              href={buttonHref}
              class="btn custom-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={buttonText || 'Call to action button'}
            >
              {buttonText}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    background-color: #242424;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    padding: 5rem 0;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cta-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .container {
    position: relative;
    z-index: 2;
  }

  .cta-title {
    color: #ffffff;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.2rem;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-block;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 3rem 0;
      min-height: auto;
    }

    .cta-title {
      font-size: 1.75rem;
    }

    .cta-subtitle {
      font-size: 1rem;
    }
  }
</style>
